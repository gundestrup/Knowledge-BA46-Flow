# Shared configuration for docker-compose.yml — values consumed by BOTH
# services. Copy to .env and adjust; compose interpolates ${KB_SHELF} into
# the container environment and env_file injects everything else.

# Shelf under ./data/knowledge both programs work on (one shelf only —
# the MCP server indexes all shelves under its root but the trigger file
# and KBM-flow's repository_path must agree on this one).
KB_SHELF=knowledge-base

# Bearer token MCP clients send to the knowledge-base server (32+ chars).
MCP_AUTH_TOKEN=change-me-to-a-32-plus-character-token

# Ollama instance shared by MCP embeddings and KBM-flow analysis.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# MCP server: embedding provider + model.
EMBEDDING_PROVIDER=ollama
OLLAMA_MODEL=embeddinggemma:300m

# KBM-flow: analysis model (deliberately separate from OLLAMA_MODEL —
# the MCP server uses that name for its own embedding/chat features).
KBM_OLLAMA_MODEL=qwen3:14b

# KBM-flow only: bearer key for Ollama's hosted web search — enables
# `freshness --web-verify`, which sends flagged claim text (never the whole
# document) to ollama.com. Leave empty to keep freshness heuristic-only.
OLLAMA_API_KEY=
